{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocudrug-graphrag/schema_v1.0.json",
  "title": "ProvenanceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_hash",
    "retrieval_subgraph_hash",
    "kg_edge_ids_touched",
    "mechanism_types_considered",
    "llm_prompt_hash",
    "llm_output_hash",
    "model_version",
    "timestamp",
    "concordance_score",
    "reliability_tier",
    "provenance_coverage_score",
    "schema_version"
  ],
  "properties": {
    "query_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "retrieval_subgraph_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kg_edge_ids_touched": { "type": "array", "items": { "type": "string" } },
    "mechanism_types_considered": { "type": "array", "items": { "type": "string" } },
    "llm_prompt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "llm_output_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "model_version": { "type": "string" },
    "timestamp": { "type": "string" },
    "concordance_score": { "type": "number", "minimum": 0.0 },
    "reliability_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "provenance_coverage_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "schema_version": { "type": "string" }
  }
}
